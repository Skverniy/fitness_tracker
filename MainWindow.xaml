<Window x:Class="fitness_tracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:fitness_tracker"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:uc="clr-namespace:fitness_tracker.UserControls"
    mc:Ignorable="d"
        Title="MainWindow" Height="760" Width="1280" Background="Transparent" ResizeMode="NoResize"
        AllowsTransparency="True" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="40" BorderThickness="2" BorderBrush="#ebeedf"
            Padding="20" MouseDown="Border_MouseDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#efefef" Offset="0"/>
                <GradientStop Color="#ededed" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="30" Background="#7163ba" Margin="20">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource topMenuButton}">
                            <Icon:PackIconMaterial Kind="BellCheckOutline" Style="{StaticResource menuButtonIcon}"/>
                        </Button>

                        <Separator Background="#877ca5" Margin="20 20 20 10" Height="0.8"/>

                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="FileDocumentEditOutline" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="Finance" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="MotionPlayOutline" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="AlarmMultiple" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0 0 0 20">
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="CogOutline" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button Style="{StaticResource menuButton}">
                            <Icon:PackIconMaterial Kind="Power" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="5 20 25 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="7 10 0 25">
                    <TextBlock Text="ДашБорд" Style="{StaticResource titleText}"/>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBlock Margin="40 0 0 0" VerticalAlignment="Center" Foreground="#594f7f"
                                   IsHitTestVisible="False" Panel.ZIndex="1" Text="Поиск ..."
                                   Visibility="{Binding ElementName=txtSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        <TextBox x:Name="txtSearch" Style="{StaticResource searchTextBox}"/>
                        <Icon:PackIconMaterial Kind="Magnify" Width="14" Height="14" Foreground="#594f7f"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15 0 0 0"/>
                    </Grid>

                    <Ellipse Width="45" Height="45" Margin="15 0 7 0" Grid.Column="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/p6.jpg"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="30" Margin="0 0 20 50">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#6a5dae" Offset="0"/>
                            <GradientStop Color="#54479c" Offset="1.2"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Обзор" Foreground="#feeff6" FontSize="18" FontWeight="SemiBold" Margin="35 25 0 0"/>
                        <TextBlock Text="Помесячно" Foreground="#feeff6" FontSize="16" FontWeight="SemiBold" Margin="0 27 35 0" HorizontalAlignment="Right"/>

                        <lvc:CartesianChart x:Name="MonthlyChart" Grid.Row="1" LegendLocation="None" Margin="10"
                                            DataTooltip="{x:Null}"
                                            MouseMove="MonthlyChart_MouseMove"
                                            ToolTipService.InitialShowDelay="0"
                                            ToolTipService.ShowDuration="60000">
                            <lvc:CartesianChart.ToolTip>
                                <ToolTip Placement="MousePoint" VerticalOffset="-38" IsHitTestVisible="False">
                                    <Border Background="#5a5080" CornerRadius="8" Padding="12 8"
                                            BorderThickness="1" BorderBrush="#6b5a99">
                                        <TextBlock x:Name="MonthlyTooltipText" Foreground="#f4f3f6"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </Border>
                                </ToolTip>
                            </lvc:CartesianChart.ToolTip>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Foreground="#a79fd1" FontSize="14" ShowLabels="True" Labels="Янв,Фев,Март,Апр,Май,Июн,Июл,Авг,Сен,Окт,Нояб,Дек">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0" Step="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis ShowLabels="False" MinValue="0" MaxValue="170">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>

                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Title="Шагов:" 
                                        Stroke="#7164b2" 
                                        StrokeThickness="4" 
                                        PointGeometrySize="6"
                                        x:Name="MonthlySeries">
                                    <lvc:LineSeries.Fill>
                                        <LinearGradientBrush>
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#f782ab" Offset="0.23"/>
                                            <GradientStop Color="Transparent" Offset="2.5"/>
                                        </LinearGradientBrush>
                                    </lvc:LineSeries.Fill>
                                </lvc:LineSeries>
                            </lvc:CartesianChart.Series>
                        </lvc:CartesianChart>

                        <Grid Grid.Row="2" Margin="10 20 10 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <uc:TextInfo TextTop="Общее время" TextMiddle="748 Часов" TextBottom="Апрель" Grid.Column="0" Loaded="TextInfo_Loaded"/>
                            <uc:TextInfo TextTop="Колл-во шагов" TextMiddle="9.178 шг." TextBottom="Апрель" IsActive="True" Grid.Column="1"/>
                            <uc:TextInfo TextTop="Цель" TextMiddle="9200 шг" TextBottom="Апрель" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="30" Background="#7163ba">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#8d82c8" CornerRadius="22" Width="70" Height="70" Margin="17" BorderThickness="1" BorderBrush="#aeadde">
                                <Icon:PackIconMaterial Kind="ShoeCleat" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Ежед-ая прогулка" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="30" Background="#fe95e8" Grid.Row="1" Margin="0 20 0 50" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border CornerRadius="30" Background="#fd91b3" VerticalAlignment="Top" BorderThickness="1" BorderBrush="#fc9cba">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#feae7a" CornerRadius="25" Width="70" Height="70" Margin="20" BorderThickness="1" BorderBrush="#fc5d8e">
                                        <Icon:PackIconMaterial Kind="Run" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Моя прогулка" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <lvc:CartesianChart LegendLocation="None" Margin="-7" Grid.Row="1" DataTooltip="{x:Null}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis ShowLabels="False">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>

                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis ShowLabels="False" MinValue="0">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>

                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries x:Name="WalkSeries" StrokeThickness="2" PointGeometrySize="0">
                                        <lvc:LineSeries.Fill>
                                            <LinearGradientBrush>
                                                <GradientStop Color="#fe95e8" Offset="0"/>
                                                <GradientStop Color="#fe779c" Offset="0.9"/>
                                            </LinearGradientBrush>
                                        </lvc:LineSeries.Fill>
                                        <lvc:LineSeries.Stroke>
                                            <LinearGradientBrush>
                                                <GradientStop Color="#fe95e8" Offset="0"/>
                                                <GradientStop Color="#fe779c" Offset="0.9"/>
                                            </LinearGradientBrush>
                                        </lvc:LineSeries.Stroke>
                                    </lvc:LineSeries>
                                </lvc:CartesianChart.Series>
                            </lvc:CartesianChart>

                            <StackPanel Grid.Row="1" Margin="30 0 0 0" VerticalAlignment="Center">
                                <TextBlock Foreground="#f8cbd9" FontSize="14" Text="Общее время"/>
                                <TextBlock Foreground="#ffffff" FontSize="24" FontWeight="SemiBold" Text="748 часов"/>
                                <TextBlock Foreground="#f8cbd9" FontSize="16" FontWeight="SemiBold" Text="Июль"/>
                            </StackPanel>

                            <Icon:PackIconMaterial Kind="ChevronRightCircleOutline" Foreground="#ffffff" Width="28" Height="28" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 40 25 0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <uc:InfoCard Grid.Column="0" Margin="10 0" Title="Прогулка на велосипеде" Desc="15 км / 2 недели"
                                 BottomText="112 км осталось" Days="2 дня назад" Value="45" Icon="Bicycle"/>

                    <uc:InfoCard Grid.Column="1" Margin="10 0" Title="Мастер прогулок" Desc="12 км / 1 неделю"
                                 BottomText="32 км осталось" Days="13 дней назад" Value="75" IsActive="True" Icon="Run"/>

                    <uc:InfoCard Grid.Column="2" Margin="10 0" Title="Заняться здоровьем" Desc="3000 шагов / 3 недели"
                                 BottomText="1200 шагов осталось" Days="5 дней назад" Value="30" Icon="HeartPulse"/>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="White" CornerRadius="30" Margin="0 20 20 20" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5 5 0 15">
                        <Icon:PackIconMaterial Kind="AccountMultipleOutline" Foreground="#594f7f" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Друзья" FontSize="16" FontWeight="Bold" Foreground="#594f7f" Margin="10 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="0" HorizontalAlignment="Right" Background="#f4f3f8" CornerRadius="15" Height="30" Margin="0 0 5 15">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Активности" Background="#7163ba" Foreground="White" BorderThickness="0" Padding="12 0" FontSize="11" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Онлайн" Background="Transparent" Foreground="#a6a0bd" BorderThickness="0" Padding="12 0" FontSize="11" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="5 0">
                        <Grid Margin="0 7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill><ImageBrush ImageSource="/Images/p1.jpg"/></Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="Кирилов Антон" FontSize="13" FontWeight="Bold" Foreground="#5d5382"/>
                                <TextBlock Text="32км за 400 минут" FontSize="11" Foreground="#a6a0bd"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0 7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill><ImageBrush ImageSource="/Images/p2.jpg"/></Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="Дворянинов Михаил" FontSize="13" FontWeight="Bold" Foreground="#5d5382"/>
                                <TextBlock Text="25км за 300 минут" FontSize="11" Foreground="#a6a0bd"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0 7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill><ImageBrush ImageSource="/Images/p3.jpg"/></Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="Серов Андрей" FontSize="13" FontWeight="Bold" Foreground="#5d5382"/>
                                <TextBlock Text="5км за 46 минут" FontSize="11" Foreground="#a6a0bd"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0 7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill><ImageBrush ImageSource="/Images/p4.jpg"/></Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="Смирнов Данил" FontSize="13" FontWeight="Bold" Foreground="#5d5382"/>
                                <TextBlock Text="15км за 40 минут" FontSize="11" Foreground="#a6a0bd"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5 15 0 10">
                        <Icon:PackIconMaterial Kind="MapMarkerOutline" Foreground="#594f7f" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Онлайн карта" FontSize="14" FontWeight="Bold" Foreground="#594f7f" Margin="8 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="3" CornerRadius="18" ClipToBounds="True">
                        <Image Source="/Images/map.png" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>